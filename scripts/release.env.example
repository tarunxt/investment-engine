RELEASE_REMOTE=origin
RELEASE_BRANCH=main
DEPLOY_WORKFLOW=deploy.yml
DEPLOY_SCOPE=full

# Optional smoke checks after deploy succeeds.
PROD_FRONTEND_URL=https://yourdomain.com
PROD_API_HEALTH_URL=https://api.yourdomain.com/health

DEPLOY_WAIT_TIMEOUT_SECONDS=1800
DEPLOY_POLL_INTERVAL_SECONDS=5
SMOKE_TIMEOUT_SECONDS=20
