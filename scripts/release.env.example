RELEASE_REMOTE=origin
RELEASE_BRANCH=main
DEPLOY_WORKFLOW=deploy.yml
DEPLOY_SCOPE=full

# Optional smoke checks after deploy succeeds when releasing from a local checkout.
PROD_FRONTEND_URL=https://cred-x.in
PROD_API_HEALTH_URL=https://cred-x.in/health/live

DEPLOY_WAIT_TIMEOUT_SECONDS=1800
DEPLOY_POLL_INTERVAL_SECONDS=5
SMOKE_TIMEOUT_SECONDS=20

# GitHub Actions production defaults:
# - Required repository secrets: EC2_HOST, EC2_USER, EC2_SSH_KEY
# - Optional repository variables: EC2_APP_PATH=/srv/investor, EC2_APP_USER=investor
