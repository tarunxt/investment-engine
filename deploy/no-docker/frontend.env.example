NODE_ENV=production
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_BRAND_PREFIX=Cred-X
NEXT_PUBLIC_BRAND_ACRONYM=TIE
NEXT_PUBLIC_BRAND_EXPANSION="Tarun's Investment Engine"
NEXT_PUBLIC_DISABLE_AUTH=false
NEXT_PUBLIC_DISABLE_API_PROXY=false
NEXT_PUBLIC_API_DEBUG=false
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=change-me
AUTH_TRUST_HOST=true
# Keep authenticated same-origin BFF reads on the local backend in no-docker
# production. This avoids spending a bounded read budget on the Docker-service
# hostname or the public API before reaching the same-host Uvicorn process.
BACKEND_API_URL=http://127.0.0.1:8000
# Auto-Live dashboard/history/detail endpoints have backend deadlines of up to
# four seconds. Keep these values below the console's five-second poll timeout.
BULLPEN_BACKEND_PROXY_TIMEOUT_MS=4200
BULLPEN_BACKEND_PROXY_TOTAL_TIMEOUT_MS=4750
# Internal database viewer origin proxied at /database. Keep the viewer bound
# to loopback; the frontend is the only public entry point.
DATABASE_VIEWER_INTERNAL_URL=http://127.0.0.1:8080
