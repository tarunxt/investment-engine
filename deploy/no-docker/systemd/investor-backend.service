# Template rendered by deploy/no-docker/redeploy.sh
[Unit]
Description=Investor FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_ROOT__/backend
Environment=APP_ROOT=__APP_ROOT__
Environment=APP_USER=__APP_USER__
EnvironmentFile=__BACKEND_ENV_FILE__
ExecStartPre=+/bin/bash __APP_ROOT__/deploy/no-docker/scripts/sync-bullpen-operator-credentials.sh
ExecStart=__APP_ROOT__/deploy/no-docker/scripts/run-backend.sh
Restart=always
RestartSec=5
# Keep the interactive API responsive while planning workers are under memory
# pressure.  MemoryLow is a reservation, not a pre-allocation.
MemoryAccounting=true
MemoryLow=1024M
MemoryHigh=2048M
MemoryMax=2560M
MemorySwapMax=512M
OOMScoreAdjust=-500
CPUWeight=200
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
