[Unit]
Description=Investor FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=investor
Group=investor
WorkingDirectory=/srv/investor/backend
EnvironmentFile=/etc/investor/backend.env
ExecStart=/srv/investor/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
