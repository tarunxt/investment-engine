DATABASE_URL=postgresql://aiuser:change-me@127.0.0.1:5432/aidb
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
FRONTEND_URL=https://yourdomain.com
UVICORN_WORKERS=2
# Main worker retains Stage 3 intent execution/reconciliation on ai.  Keep
# prefetch at one so a prefork child does not reserve a long hidden backlog.
CELERY_WORKER_QUEUES=ai,email
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1
# Bound retained Bullpen/order-history payloads in long-lived prefork children.
CELERY_WORKER_MAX_TASKS_PER_CHILD=25
CELERY_WORKER_MAX_MEMORY_PER_CHILD_KB=800000
# Dedicated planning worker for execute_polymarket_auto_live_run.
CELERY_AUTO_LIVE_WORKER_QUEUE=auto_live
CELERY_AUTO_LIVE_WORKER_CONCURRENCY=1
CELERY_AUTO_LIVE_WORKER_PREFETCH_MULTIPLIER=1
# Stage 1/2 scans can temporarily exceed 1 GiB. Replace the child after every
# completed task so that memory is returned before the next hourly cycle.
CELERY_AUTO_LIVE_MAX_TASKS_PER_CHILD=1
CELERY_AUTO_LIVE_FALLBACK_QUEUE=ai
AUTO_LIVE_PRIMARY_HANDOFF_TIMEOUT_SECONDS=30
AUTO_LIVE_FALLBACK_HANDOFF_TIMEOUT_SECONDS=180
# Required consumer for periodic dispatch/recovery tasks routed to beat.
CELERY_BEAT_WORKER_QUEUE=beat
CELERY_BEAT_WORKER_PREFETCH_MULTIPLIER=1

# Auto-Live planning lifecycle and redelivery safety.
AUTO_LIVE_RUN_EXECUTION_LEASE_TTL_SECONDS=120
# The application clamps this to at most one-third of the execution-lease TTL.
AUTO_LIVE_RUN_HEARTBEAT_INTERVAL_SECONDS=20
AUTO_LIVE_RUN_WORKER_LOSS_GRACE_SECONDS=300
AUTO_LIVE_RUN_STARTUP_RECOVERY_GRACE_SECONDS=300
AUTO_LIVE_RUN_REDELIVERY_RETRY_SECONDS=15

# Stage 3 order intent work is separately lease-fenced while queued/active.
AUTO_LIVE_ORDER_INTENT_OPERATION_LEASE_SECONDS=3600
# Base runtime lease is intentionally longer than observed Bullpen runtime
# lock waits; worker heartbeats refresh it every minute and token-fence it.
AUTO_LIVE_ORDER_INTENT_OPERATION_ACTIVE_LEASE_SECONDS=1800

# Coalesce repeated run-audit refreshes from Stage 3 polls.
BULLPEN_RUN_AUDIT_REFRESH_DEBOUNCE_SECONDS=5
BULLPEN_RUN_AUDIT_REFRESH_LEASE_SECONDS=300

SECRET_KEY=change-me
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
GEMINI_API_KEY_FALLBACK_2=
GEMINI_API_KEY_FALLBACK_3=
DEEPSEEK_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Investment Engine

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/console/google-sheets/callback
GOOGLE_SHEETS_ENCRYPTION_KEY=

ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_TOKEN_ENCRYPTION_KEY=
ZERODHA_ENABLE_DIRECT_MARKET_ORDERS=false

POLYMARKET_DATA_DIR=/srv/investment-engine/backend/data/polymarket

# Polymarket / Bullpen live trading is opt-in.
# Keep credentials in runtime secrets, never commit wallet keys.
PAPER_TRADING=false
LIVE_TRADING=false
USE_LIVE_READS=true
JURISDICTION_CONFIRMATION=true
LIVE_UNLOCK_MODE=manual
POLYMARKET_AUTO_START=false
REQUIRE_MANUAL_CONFIRMATION=false
AUTO_EXECUTE_LIVE=true
MAX_LIVE_TRADE_SIZE=1
MAX_LIVE_TRADES_PER_DAY=5
MAX_LIVE_DAILY_LOSS=10
MAX_LIVE_EXPOSURE_PER_MARKET=5
POLYMARKET_DIRECT_PAPER_TRADING=false
POLYMARKET_DIRECT_LIVE_TRADING=false
POLYMARKET_DIRECT_USE_LIVE_READS=true
POLYMARKET_DIRECT_LIVE_UNLOCK_MODE=manual
POLYMARKET_DIRECT_AUTO_START=false
POLYMARKET_DIRECT_MAX_LIVE_TRADE_SIZE=1
POLYMARKET_DIRECT_MAX_LIVE_TRADES_PER_DAY=5
POLYMARKET_DIRECT_MAX_LIVE_DAILY_LOSS=10
POLYMARKET_DIRECT_MAX_LIVE_EXPOSURE_PER_MARKET=5
BULLPEN_AUTO_LIVE_ALLOW_EXECUTION=false
BULLPEN_BIN=/usr/local/bin/bullpen
# Keep the centralized backend Bullpen runtime on the credential HOME used by
# the operator login. Frontend requests proxy this runtime and own no login.
BULLPEN_HOME=/home/investor/.bullpen
BULLPEN_CREDENTIALS_HOME=/home/investor/.bullpen
# Passive systemd monitoring reads only the centralized broker's Redis cache.
BULLPEN_HEALTH_STATE_DIR=/home/investor/.bullpen-health
BULLPEN_HEALTH_WEBHOOK_URL=
BULLPEN_HEALTH_WEBHOOK_TIMEOUT_SECONDS=10
