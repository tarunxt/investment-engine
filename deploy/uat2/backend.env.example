CREDX_UAT2=1
ENVIRONMENT=uat2
AUTH_DISABLED=false
UAT2_ADAPTERS=simulation
UAT2_FIXTURE_STATE=populated
FRONTEND_URL=https://uat2.cred-x.in
DATABASE_URL=REQUIRED_UAT2_DATABASE_URL
REDIS_URL=redis://redis:6379/0
UAT2_JWT_SIGNING_KEY={{resolve:secretsmanager:credx-uat2:SecretString:jwt-signing-key}}
GOOGLE_SIGNIN_CLIENT_ID=REQUIRED_INDEPENDENT_PUBLIC_CLIENT_ID
