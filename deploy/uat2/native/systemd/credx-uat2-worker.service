[Unit]
Description=CredX UAT2 worker
Requires=credx-uat2-postgres.service credx-uat2-redis.service credx-uat2-certs.service
After=network-online.target credx-uat2-postgres.service credx-uat2-redis.service credx-uat2-certs.service
Requires=credx-uat2-network.service
After=credx-uat2-network.service
[Service]
Type=simple
User=credx-uat2-app
Group=credx-uat2-app
WorkingDirectory=/opt/credx-uat2/current/backend
EnvironmentFile=/etc/credx-uat2/backend.env
EnvironmentFile=/etc/credx-uat2/release.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/python3 /opt/credx-uat2/current/deploy/uat2/native/runtime-preflight.py
ExecStart=/opt/credx-uat2/current/.venv/bin/celery -A app.uat2.worker worker -Q uat2_simulation,uat2_analysis,uat2_orders,uat2_reconcile --concurrency=1 --prefetch-multiplier=1 --max-tasks-per-child=25 --loglevel=warning
MemoryMax=512M
TasksMax=128
ReadWritePaths=/var/lib/credx-uat2/artifacts
Restart=on-failure
RestartSec=3
TimeoutStartSec=60
TimeoutStopSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_UNIX
LimitNOFILE=4096
LogNamespace=credx-uat2
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200
IPAddressDeny=any
IPAddressAllow=localhost
[Install]
WantedBy=multi-user.target
