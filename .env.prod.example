# ═════════════════════════════════════════════════════════════════════════════
# Production Environment Configuration
# Copy to .env.prod and fill in actual production values (DO NOT COMMIT .env.prod)
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=aiuser
POSTGRES_PASSWORD=<generate-strong-password>
POSTGRES_DB=aidb
DATABASE_URL=postgresql://aiuser:<password>@postgres:5432/aidb

# ─────────────────────────────────────────────────────────────────────────────
# Redis Configuration
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─────────────────────────────────────────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=production
SECRET_KEY=<generate-strong-secret-key>
ALLOWED_HOSTS=*.yourdomain.com,yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ─────────────────────────────────────────────────────────────────────────────
# Authentication & Security
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=<generate-strong-jwt-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# Email Configuration (SMTP)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=<sendgrid-api-key>
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Investor Platform

# ─────────────────────────────────────────────────────────────────────────────
# AI Provider Configuration
# ─────────────────────────────────────────────────────────────────────────────
# OpenAI
OPENAI_API_KEY=<openai-api-key>

# Anthropic
ANTHROPIC_API_KEY=<anthropic-api-key>

# Google Gemini
GEMINI_API_KEY=<gemini-api-key>
GEMINI_API_KEY_FALLBACK=<gemini-api-key-fallback-1>
GEMINI_API_KEY_FALLBACK_2=<gemini-api-key-fallback-2>
GEMINI_API_KEY_FALLBACK_3=<gemini-api-key-fallback-3>

# DeepSeek
DEEPSEEK_API_KEY=<deepseek-api-key>

# ─────────────────────────────────────────────────────────────────────────────
# Google Sheets Integration
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_SHEETS_CLIENT_ID=<google-oauth-client-id>
GOOGLE_SHEETS_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_SHEETS_REDIRECT_URI=https://yourdomain.com/console/google-sheets/callback
GOOGLE_SHEETS_SCOPES=https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/drive

# ─────────────────────────────────────────────────────────────────────────────
# Zerodha Integration
# ─────────────────────────────────────────────────────────────────────────────
ZERODHA_CLIENT_ID=<zerodha-client-id>
ZERODHA_CLIENT_SECRET=<zerodha-client-secret>
ZERODHA_REDIRECT_URI=https://yourdomain.com/console/zerodha

# ─────────────────────────────────────────────────────────────────────────────
# Encryption Keys
# ─────────────────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=<generate-base64-32-byte-key>

# ─────────────────────────────────────────────────────────────────────────────
# Logging & Monitoring
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SENTRY_DSN=https://<sentry-key>@sentry.io/<project-id>

# ─────────────────────────────────────────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────────────────────────────────────────
FEATURE_GOOGLE_SHEETS=true
FEATURE_ZERODHA_TRADING=true
FEATURE_SCHEDULED_JOBS=true
